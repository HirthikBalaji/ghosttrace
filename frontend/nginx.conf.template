server {
  listen 8080;
  root /usr/share/nginx/html;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${GT_CSP_CONNECT_EXTRA}; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;
  client_max_body_size 256k;
  location /api/ { proxy_pass http://backend:8000; proxy_read_timeout 120s; }
  location = /ready { proxy_pass http://backend:8000; }
  location = /health { proxy_pass http://backend:8000; }
  location / { try_files $uri /index.html; }
}
